{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UT quality evidence 1.1.0",
  "type": "object",
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "traces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trace"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage"
      }
    },
    "reviewed_test_ids": {
      "type": "object",
      "properties": {
        "A": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "B": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "policy": {
      "$ref": "#/$defs/policy"
    }
  },
  "required": [
    "sources",
    "requirements",
    "traces",
    "issues",
    "coverage",
    "reviewed_test_ids",
    "policy"
  ],
  "additionalProperties": false,
  "$defs": {
    "metric": {
      "type": "object",
      "properties": {
        "covered": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "covered",
        "total"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "type": {
          "enum": [
            "user",
            "prd",
            "spec",
            "acceptance",
            "story",
            "implementation"
          ],
          "type": "string"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "enum": [
            "authoritative",
            "ambiguous",
            "conflicting",
            "supporting"
          ],
          "type": "string"
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "type",
        "reference",
        "authority",
        "excerpt"
      ],
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "module_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "未评级"
          ],
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "testability": {
          "enum": [
            "testable",
            "ambiguous",
            "conflicting",
            "untestable"
          ],
          "type": "string"
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "enum": [
                  "normal",
                  "error",
                  "boundary",
                  "state",
                  "security",
                  "other"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "description",
              "category"
            ],
            "additionalProperties": false
          }
        },
        "applicable_projects": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "A",
              "B"
            ]
          },
          "minItems": 1
        },
        "applicability_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "priority_reason": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "module_id",
        "description",
        "priority",
        "source_ids",
        "testability",
        "criteria"
      ],
      "additionalProperties": false
    },
    "trace": {
      "type": "object",
      "properties": {
        "requirement_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "project_id": {
          "enum": [
            "A",
            "B"
          ],
          "type": "string"
        },
        "status": {
          "enum": [
            "SUFFICIENT",
            "PARTIAL",
            "UNCOVERED",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "test_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "covered_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_scenarios": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assertion_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "test_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "criteria_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "validity": {
                "enum": [
                  "valid",
                  "uncertain"
                ],
                "type": "string"
              }
            },
            "required": [
              "test_id",
              "path",
              "line",
              "code",
              "criteria_ids",
              "validity"
            ],
            "additionalProperties": false
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "requirement_id",
        "project_id",
        "status",
        "test_ids",
        "covered_criteria",
        "missing_scenarios",
        "assertion_evidence",
        "reason",
        "evidence"
      ],
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "project_id": {
          "enum": [
            "A",
            "B"
          ],
          "type": "string"
        },
        "test_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "type": {
          "enum": [
            "conflict",
            "weak_assertion",
            "missing_scenario",
            "duplicate",
            "uncertain",
            "other"
          ],
          "type": "string"
        },
        "severity": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "type": "string"
        },
        "certainty": {
          "enum": [
            "confirmed",
            "suspected"
          ],
          "type": "string"
        },
        "verification": {
          "enum": [
            "heuristic",
            "source_review",
            "execution",
            "mutation"
          ],
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "project_id",
        "test_ids",
        "requirement_ids",
        "type",
        "severity",
        "certainty",
        "verification",
        "description",
        "evidence",
        "recommendation"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "project_id": {
          "enum": [
            "A",
            "B"
          ],
          "type": "string"
        },
        "collected": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "tool_version": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "run_at": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "UT",
            "MIXED",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "scope_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifact": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "denominator": {
          "type": "string",
          "minLength": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unmeasured_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "metrics": {
          "type": "object",
          "properties": {
            "line": {
              "$ref": "#/$defs/metric"
            },
            "branch": {
              "$ref": "#/$defs/metric"
            },
            "function": {
              "$ref": "#/$defs/metric"
            },
            "statement": {
              "$ref": "#/$defs/metric"
            },
            "condition": {
              "$ref": "#/$defs/metric"
            },
            "mutation": {
              "$ref": "#/$defs/metric"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "metrics": {
                "type": "object",
                "properties": {
                  "line": {
                    "$ref": "#/$defs/metric"
                  },
                  "branch": {
                    "$ref": "#/$defs/metric"
                  },
                  "function": {
                    "$ref": "#/$defs/metric"
                  },
                  "statement": {
                    "$ref": "#/$defs/metric"
                  },
                  "condition": {
                    "$ref": "#/$defs/metric"
                  },
                  "mutation": {
                    "$ref": "#/$defs/metric"
                  }
                },
                "required": [],
                "additionalProperties": false
              },
              "uncovered_lines": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "uncovered_branches": {
                "type": "array",
                "items": {}
              },
              "uncovered_blocks": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            },
            "required": [
              "path",
              "metrics"
            ],
            "additionalProperties": false
          }
        },
        "source_context": {
          "type": "object"
        },
        "report_command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "test_artifact": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "project_id",
        "collected"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "code": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric": {
                "enum": [
                  "line",
                  "branch",
                  "function",
                  "statement",
                  "condition",
                  "mutation"
                ],
                "type": "string"
              },
              "minimum": {
                "type": "number",
                "minimum": 0
              },
              "mandatory": {
                "type": "boolean"
              },
              "basis": {
                "type": "string",
                "minLength": 1
              },
              "project_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "module_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              }
            },
            "required": [
              "metric",
              "minimum",
              "mandatory",
              "basis"
            ],
            "additionalProperties": false
          }
        },
        "requirements": {
          "type": "object",
          "properties": {
            "core_must_be_sufficient": {
              "type": "boolean"
            },
            "minimum_sufficient_percent": {
              "type": "number",
              "minimum": 0
            },
            "mandatory": {
              "type": "boolean"
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "mandatory",
            "basis"
          ],
          "additionalProperties": false
        },
        "effectiveness": {
          "type": "object",
          "properties": {
            "no_confirmed_high_risk": {
              "type": "boolean"
            },
            "mandatory": {
              "type": "boolean"
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "mandatory",
            "basis"
          ],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    }
  }
}
